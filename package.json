{
  "name": "lukas-portfolio",
  "version": "1.0.0",
  "description": "Portfolio web - Lukáš Drštička",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:images",
    "build:css": "tailwindcss -i src/css/main.css -o dist/css/styles.min.css --minify",
    "build:js": "node scripts/build-js.js",
    "build:images": "node scripts/optimize-images.js",
    "dev": "concurrently \"npm run watch:css\" \"npx serve .\"",
    "watch:css": "tailwindcss -i src/css/main.css -o dist/css/styles.min.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.35",
    "sharp": "^0.33.2",
    "tailwindcss": "^3.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
