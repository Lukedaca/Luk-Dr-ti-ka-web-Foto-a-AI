{
  "name": "lukas-portfolio",
  "version": "1.0.0",
  "description": "Portfolio website - Lukas Drsticka",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:images",
    "build:css": "npx tailwindcss -i src/css/main.css -o dist/css/tailwind.tmp.css --minify && node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:images": "node scripts/optimize-images.js",
    "watch:css": "npx tailwindcss -i src/css/main.css -o dist/css/styles.min.css --watch",
    "dev": "npx concurrently \"npm run watch:css\" \"npx serve .\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.35",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.8",
    "@netlify/functions": "^5.1.5"
  }
}
