{
  "name": "@framemind/solution",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Provider-independent local orchestration, knowledge and privacy core for FrameMind agents",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "training:evaluate": "node --import ../viktorie-prerov-agent/node_modules/tsx/dist/loader.mjs scripts/evaluate-agents.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "compliance:verify": "node scripts/verify-compliance.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && npm run compliance:verify"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
